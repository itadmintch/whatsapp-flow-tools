{
  "routing_model": {
    "WELCOME": ["ADMISSION"],
    "ADMISSION": ["REGISTRATION", "PASIEN"],
    "REGISTRATION": ["KONFIRMASI"],
    "PASIEN": ["KONFIRMASI"],
    "KONFIRMASI": ["COMPLETE"],
    "COMPLETE": []
  },
  "data_api_version": "3.0",
  "screens": [
    {
      "id": "WELCOME",
      "title": "WELCOME",
      "data": {
        "welcome_message": {
          "type": "string",
          "__example__": "Selamat Datang di Sistem Booking Tzu Chi Hospital!"
        }
      },
      "layout": {
        "children": [
          {
            "type": "TextSubheading",
            "text": "Selamat Datang di Sistem Booking Tzu Chi Hospital!"
          },
          {
            "label": "Selanjutnya",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "trigger": "INIT"
              }
            },
            "type": "Footer"
          }
        ],
        "type": "SingleColumnLayout"
      }
    },
    {
      "id": "ADMISSION",
      "title": "PENDAFTARAN",
      "data": {
        "error_messages": {
          "type": "string",
          "__example__": ""
        },
        "klinik": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "1",
              "title": "Anak - Imunisasi Anak"
            },
            {
              "id": "2",
              "title": "Anastesi"
            },
            {
              "id": "3",
              "title": "Gizi"
            },
            {
              "id": "4",
              "title": "Jantung"
            },
            {
              "id": "5",
              "title": "Mata"
            }
          ]
        },
        "dokter": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "klinik_id": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "1",
              "title": "dr. Sarah Wijaya, M.Sc, Sp.A",
              "image": ""
            },
            {
              "id": "2",
              "title": "dr. Maria Indriati, Sp.An-KIC"
            },
            {
              "id": "3",
              "title": "Bastian, S.ST., RD"
            },
            {
              "id": "4",
              "title": "dr. Ahmad Prasetyo, Sp.JP"
            }
          ]
        },
        "is_dokter_enabled": {
          "type": "boolean",
          "__example__": true
        },
        "date": {
          "type": "object",
          "properties": {
            "minDate": {
              "type": "string"
            },
            "maxDate": {
              "type": "string"
            },
            "unavailableDates": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "includeDays": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "initValue": {
              "type": "string"
            }
          },
          "__example__": {
            "minDate": "2026-10-01",
            "maxDate": "2026-12-30",
            "unavailableDates": [],
            "includeDays": [],
            "initValue": "2026-10-01"
          }
        },
        "is_date_enabled": {
          "type": "boolean",
          "__example__": true
        },
        "time": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "08:00-12:00",
              "title": "08:00-12:00"
            },
            {
              "id": "13:00-17:00",
              "title": "13:00-17:00",
              "enabled": false
            }
          ]
        },
        "is_time_enabled": {
          "type": "boolean",
          "__example__": true
        },
        "tipe_pasien": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "1",
              "title": "Pasien Baru"
            },
            {
              "id": "2",
              "title": "Pasien Lama"
            }
          ]
        },
        "pembayaran": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "1",
              "title": "Pribadi"
            },
            {
              "id": "2",
              "title": "Asuransi"
            }
          ]
        },
        "is_pasien_baru": {
          "type": "boolean",
          "__example__": true
        }
      },
      "layout": {
        "children": [
          {
            "name": "admission",
            "type": "Form",
            "error-messages": {
              "dokter": "${data.error_messages}"
            },
            "children": [
              {
                "text": "Buat Janji Temu Dokter",
                "type": "TextSubheading"
              },
              {
                "type": "TextBody",
                "text": "Pilih klinik dan jadwal dokter yang tersedia"
              },
              {
                "type": "Dropdown",
                "label": "Pilih Klinik",
                "name": "klinik",
                "data-source": "${data.klinik}",
                "required": true,
                "on-select-action": {
                  "name": "data_exchange",
                  "payload": {
                    "trigger": "klinik_selected",
                    "klinik": "${form.klinik}"
                  }
                },
                "on-unselect-action": {
                  "name": "update_data",
                  "payload": {
                    "is_dokter_enabled": false,
                    "is_date_enabled": false,
                    "is_time_enabled": false
                  }
                }
              },
              {
                "type": "Dropdown",
                "label": "Pilih Dokter",
                "name": "dokter",
                "data-source": "${data.dokter}",
                "required": "${data.is_dokter_enabled}",
                "enabled": "${data.is_dokter_enabled}",
                "on-select-action": {
                  "name": "data_exchange",
                  "payload": {
                    "trigger": "dokter_selected",
                    "klinik": "${form.klinik}",
                    "dokter": "${form.dokter}"
                  }
                },
                "on-unselect-action": {
                  "name": "update_data",
                  "payload": {
                    "is_date_enabled": false,
                    "is_time_enabled": false
                  }
                }
              },
              {
                "type": "CalendarPicker",
                "name": "calendar",
                "label": "Pilih Tanggal",
                "required": "${data.is_date_enabled}",
                "enabled": "${data.is_date_enabled}",
                "mode": "single",
                "min-date": "${data.date.minDate}",
                "max-date": "${data.date.maxDate}",
                "unavailable-dates": "${data.date.unavailableDates}",
                "include-days": "${data.date.includeDays}",
                "on-select-action": {
                  "name": "data_exchange",
                  "payload": {
                    "klinik": "${form.klinik}",
                    "dokter": "${form.dokter}",
                    "date": "${form.calendar}"
                  }
                }
              },
              {
                "type": "Dropdown",
                "label": "Pilih Slot Jam",
                "name": "time",
                "data-source": "${data.time}",
                "required": "${data.is_time_enabled}",
                "enabled": "${data.is_time_enabled}"
              },
              {
                "type": "RadioButtonsGroup",
                "label": "Tipe Pasien",
                "name": "tipe_pasien",
                "data-source": "${data.tipe_pasien}",
                "required": true
              },
              {
                "type": "RadioButtonsGroup",
                "label": "Pembayaran",
                "name": "pembayaran",
                "data-source": "${data.pembayaran}",
                "required": true
              },
              {
                "type": "Footer",
                "label": "Selanjutnya",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "trigger": "continue_selected",
                    "klinik": "${form.klinik}",
                    "dokter": "${form.dokter}",
                    "date": "${form.calendar}",
                    "time": "${form.time}",
                    "tipe_pasien": "${form.tipe_pasien}",
                    "pembayaran": "${form.pembayaran}"
                  }
                }
              }
            ]
          }
        ],
        "type": "SingleColumnLayout"
      }
    },
    {
      "id": "REGISTRATION",
      "title": "REGISTRASI",
      "data": {
        "jenis_kelamin": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "1",
              "title": "Laki-Laki"
            },
            {
              "id": "2",
              "title": "Perempuan"
            }
          ]
        }
      },
      "layout": {
        "children": [
          {
            "children": [
              {
                "text": "Silakan isi nama lengkap, tanggal lahir & nomor telepon atau Whatsapp Anda.",
                "type": "TextCaption"
              },
              {
                "input-type": "text",
                "label": "Nama Lengkap",
                "helper-text": "Sesuai KTP",
                "name": "nama_lengkap",
                "required": true,
                "type": "TextInput",
                "min-chars": 3
              },
              {
                "label": "Tanggal Lahir",
                "helper-text": "Sesuai KTP",
                "name": "tanggal_lahir",
                "required": true,
                "type": "CalendarPicker"
              },
              {
                "input-type": "text",
                "label": "Nomor Telepon",
                "name": "nomor_telepon",
                "helper-text": "Mohon masukkan angka saja",
                "required": true,
                "type": "TextInput",
                "min-chars": 3
              },
              {
                "data-source": "${data.jenis_kelamin}",
                "label": "Jenis Kelamin",
                "name": "jenis_kelamin",
                "required": true,
                "type": "RadioButtonsGroup"
              },
              {
                "label": "Selanjutnya",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "trigger": "submit_registration",
                    "nama_lengkap": "${form.nama_lengkap}",
                    "tanggal_lahir": "${form.tanggal_lahir}",
                    "nomor_telepon": "${form.nomor_telepon}",
                    "jenis_kelamin": "${form.jenis_kelamin}",
                    "klinik": "${screen.ADMISSION.form.klinik}",
                    "dokter": "${screen.ADMISSION.form.dokter}"
                  }
                },
                "type": "Footer"
              }
            ],
            "name": "flow_path",
            "type": "Form"
          }
        ],
        "type": "SingleColumnLayout"
      }
    },
    {
      "id": "PASIEN",
      "title": "PASIEN TERDAFTAR",
      "layout": {
        "children": [
          {
            "children": [
              {
                "text": "Silakan isi nama lengkap, tanggal lahir & nomor telepon atau Whatsapp yang terdaftar",
                "type": "TextCaption"
              },
              {
                "input-type": "text",
                "label": "Nama Lengkap",
                "helper-text": "Sesuai KTP",
                "name": "pasien_nama",
                "required": true,
                "type": "TextInput"
              },
              {
                "label": "Tanggal Lahir",
                "helper-text": "Sesuai KTP",
                "name": "pasien_tanggal_lahir",
                "required": true,
                "type": "CalendarPicker"
              },
              {
                "input-type": "text",
                "label": "Nomor Telepon",
                "helper-text": "Mohon masukkan angka saja.",
                "name": "pasien_nomor_telepon",
                "required": true,
                "type": "TextInput"
              },
              {
                "label": "Selanjutnya",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "trigger": "sign_in",
                    "pasien_nama": "${form.pasien_nama}",
                    "pasien_tanggal_lahir": "${form.pasien_tanggal_lahir}",
                    "pasien_nomor_telepon": "${form.pasien_nomor_telepon}",
                    "klinik": "${screen.ADMISSION.form.klinik}",
                    "dokter": "${screen.ADMISSION.form.dokter}"
                  }
                },
                "type": "Footer"
              }
            ],
            "name": "flow_path",
            "type": "Form"
          }
        ],
        "type": "SingleColumnLayout"
      }
    },
    {
      "id": "KONFIRMASI",
      "data": {
        "user_id": {
          "type": "string",
          "__example__": ""
        },
        "pasien_nama": {
          "type": "string",
          "__example__": ""
        },
        "nama_lengkap": {
          "type": "string",
          "__example__": ""
        },
        "nomor_telepon": {
          "type": "string",
          "__example__": ""
        },
        "is_jenis_kelamin_enabled": {
          "type": "boolean",
          "__example__": false
        },
        "klinik": {
          "type": "string",
          "__example__": ""
        },
        "dokter": {
          "type": "string",
          "__example__": ""
        }
      },
      "layout": {
        "children": [
          {
            "children": [
              {
                "text": "Buat Janji Dokter",
                "type": "TextSubheading"
              },
              {
                "text": "`'Tipe Pasien: **' ${screen.ADMISSION.form.tipe_pasien} '**'`",
                "markdown": true,
                "type": "TextBody"
              },
              {
                "text": "`'Nama: **' ${data.pasien_nama} '**'`",
                "type": "TextBody",
                "visible": "`${data.pasien_nama} != ''`",
                "markdown": true
              },
              {
                "text": "`'Nama: **' ${data.nama_lengkap} '**'`",
                "type": "TextBody",
                "visible": "`${data.nama_lengkap} != ''`",
                "markdown": true
              },
              {
                "text": "`'Nomor Telepon: **' ${data.nomor_telepon} '**'`",
                "type": "TextBody",
                "visible": "`${data.nomor_telepon} != ''`",
                "markdown": true
              },
              {
                "type": "TextBody",
                "text": "`'Jenis Kelamin: **' ${screen.REGISTRATION.form.jenis_kelamin} '**'`",
                "visible": "${data.is_jenis_kelamin_enabled}",
                "markdown": true
              },
              {
                "type": "TextBody",
                "text": "`'Pembayaran: **' ${screen.ADMISSION.form.pembayaran} '**'`",
                "markdown": true
              },
              {
                "text": "`'Klinik: '${screen.ADMISSION.form.klinik}`",
                "type": "TextBody",
                "visible": false
              },
              {
                "type": "TextInput",
                "name": "klinikText",
                "label": "Klinik",
                "enabled": false
              },
              {
                "text": "`'Dokter: ' ${screen.ADMISSION.form.dokter}`",
                "type": "TextBody",
                "visible": false
              },
              {
                "type": "TextInput",
                "name": "dokterText",
                "label": "Dokter",
                "enabled": false
              },
              {
                "text": "Tanggal [YYYY-MM-DD]:",
                "type": "TextBody"
              },
              {
                "text": "`${screen.ADMISSION.form.calendar}`",
                "type": "TextBody",
                "font-weight": "bold"
              },
              {
                "text": "`'Jam: **' ${screen.ADMISSION.form.time} '**'`",
                "type": "TextBody",
                "markdown": true
              },
              {
                "text": "Harap pastikan data Anda benar",
                "type": "TextCaption"
              },
              {
                "label": "Booking Sekarang",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "trigger": "submit_booking",
                    "user_id": "${data.user_id}",
                    "nama_lengkap": "${data.nama_lengkap}",
                    "tanggal_lahir": "${screen.REGISTRATION.form.tanggal_lahir}",
                    "nomor_telepon": "${screen.REGISTRATION.form.nomor_telepon}",
                    "jenis_kelamin": "${screen.REGISTRATION.form.jenis_kelamin}",
                    "pasien_nama": "${data.pasien_nama}",
                    "pasien_tanggal_lahir": "${screen.PASIEN.form.pasien_tanggal_lahir}",
                    "pasien_nomor_telepon": "${screen.PASIEN.form.pasien_nomor_telepon}",
                    "klinik": "${screen.ADMISSION.form.klinik}",
                    "dokter": "${screen.ADMISSION.form.dokter}",
                    "date": "${screen.ADMISSION.form.calendar}",
                    "time": "${screen.ADMISSION.form.time}",
                    "tipe_pasien": "${screen.ADMISSION.form.tipe_pasien}",
                    "pembayaran": "${screen.ADMISSION.form.pembayaran}"
                  }
                },
                "type": "Footer"
              }
            ],
            "name": "flow_path",
            "type": "Form",
            "init-values": {
              "klinikText": "${data.klinik}",
              "dokterText": "${data.dokter}"
            }
          }
        ],
        "type": "SingleColumnLayout"
      },
      "title": "KONFIRMASI"
    },
    {
      "id": "COMPLETE",
      "title": "Booking Berhasil",
      "data": {
        "success_image": {
          "type": "string",
          "__example__": ""
        },
        "tipe_pasien": {
          "type": "string",
          "__example__": ""
        },
        "nama_lengkap": {
          "type": "string",
          "__example__": ""
        },
        "tanggal_lahir": {
          "type": "string",
          "__example__": ""
        },
        "nomor_telepon": {
          "type": "string",
          "__example__": ""
        },
        "jenis_kelamin": {
          "type": "string",
          "__example__": ""
        },
        "klinik": {
          "type": "string",
          "__example__": ""
        },
        "dokter": {
          "type": "string",
          "__example__": ""
        },
        "date": {
          "type": "string",
          "__example__": ""
        },
        "time": {
          "type": "string",
          "__example__": ""
        },
        "pembayaran": {
          "type": "string",
          "__example__": ""
        }
      },
      "terminal": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "flow_path",
            "children": [
              {
                "type": "Image",
                "src": "${data.success_image}",
                "height": 128,
                "scale-type": "contain"
              },
              {
                "type": "Footer",
                "label": "Selesai",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "tipe_pasien": "${data.tipe_pasien}",
                    "nama_lengkap": "${data.nama_lengkap}",
                    "tanggal_lahir": "${data.tanggal_lahir}",
                    "nomor_telepon": "${data.nomor_telepon}",
                    "jenis_kelamin": "${data.jenis_kelamin}",
                    "klinik": "${data.klinik}",
                    "dokter": "${data.dokter}",
                    "date": "${data.date}",
                    "time": "${data.time}",
                    "pembayaran": "${data.pembayaran}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ],
  "version": "7.2"
}
